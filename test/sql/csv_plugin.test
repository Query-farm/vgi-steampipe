# name: test/sql/csv_plugin.test
# description: The published turbot/csv plugin from ghcr.io (cached; skipped offline with an empty cache)
# group: [steampipe]

require vgi

require-env STEAMPIPE_WORKER

require-env STEAMPIPE_GHCR

require-env STEAMPIPE_GHCR_CACHE

require-env STEAMPIPE_DATA_DIR

# csv is a dynamic-schema plugin: its tables come from the paths in the config.
statement ok
ATTACH 'steampipe' AS sp (TYPE vgi, LOCATION '{STEAMPIPE_WORKER}', plugins 'csv@1.3.0',
    cache_dir '{STEAMPIPE_GHCR_CACHE}', config '{"csv": {"paths": ["{STEAMPIPE_DATA_DIR}/*.csv"]}}');

query TTT
SELECT plugin, plugin_version, schema_mode FROM sp.main.plugin;
----
csv	1.3.0	dynamic

query T
SELECT ref FROM sp.main.plugin;
----
https://ghcr.io/turbot/steampipe/plugins/turbot/csv:1.3.0

query T
SELECT table_name FROM duckdb_tables() WHERE database_name = 'sp' AND schema_name = 'csv' ORDER BY 1;
----
cities
products

query TR
SELECT name, price::DOUBLE FROM sp.csv.products WHERE category = 'tools' ORDER BY price::DOUBLE DESC;
----
gizmo	30.0
widget	12.5
sprocket	4.25

query TI
SELECT country, count(*) FROM sp.csv.cities GROUP BY country ORDER BY country;
----
FR	2
NO	1

query II
SELECT (SELECT count(*) FROM sp.csv.cities), (SELECT count(*) FROM sp.csv.products);
----
3	4
